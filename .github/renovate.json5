{
    $schema: "https://docs.renovatebot.com/renovate-schema.json",
    extends: ["config:recommended"],
    dependencyDashboard: false,
    semanticCommits: "enabled",
    // The token owner's address, not Renovate's default (a GitHub user owned by Mend).
    gitAuthor: "Renovate <114414637+pa-decarvalho@users.noreply.github.com>",
    // Only the template: generated projects, brigade included, get its versions
    // through a release and mise run brigade:update.
    includePaths: ["template/**"],
    // Template files have Jinja names, which the default file patterns do not match.
    mise: {
        // Tool fragments are Jinja: a customManagers entry reads their pins.
        managerFilePatterns: ["/^template/\\.mise/conf\\.d/[^/]*(\\.toml|\\{% endif %\\})$/"],
    },
    "github-actions": {
        managerFilePatterns: ["/^template/.*/workflows/[^/]*(\\.yml|\\{% endif %\\})(\\.jinja)?$/", "/^template/.*/actions/[^/]+/action\\.yml$/"],
    },
    gitlabci: {
        managerFilePatterns: ["/^template/.*\\.gitlab[^/]*/ci/[^/]+\\.yml/"],
    },
    customManagers: [
        {
            // Python tools pinned inside commands
            customType: "regex",
            managerFilePatterns: ["/^template/\\.mise/config\\.toml$/", "/^template/\\.mise/conf\\.d/.*tool-ctt.*\\.jinja$/"],
            matchStrings: ["(?<depName>copier-template-tester|copier)(?:==|@)(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
            datasourceTemplate: "pypi",
        },
        {
            // mise installed by its script (Gitea/Forgejo action)
            customType: "regex",
            managerFilePatterns: ["/^template/.*/actions/[^/]+/action\\.yml$/"],
            matchStrings: ["MISE_VERSION=v(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
            depNameTemplate: "jdx/mise",
            datasourceTemplate: "github-releases",
            extractVersionTemplate: "^v(?<version>.*)$",
        },
        {
            // Tool fragments: the version is brigade's default in the Jinja file.
            customType: "regex",
            managerFilePatterns: ["/^template/\\.mise/conf\\.d/.+\\.jinja$/"],
            matchStrings: ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[^\\n]*default\\('(?<currentValue>[^']+)', true\\)"],
            extractVersionTemplate: "^v?(?<version>.*)$",
        },
    ],
    // One PR, major updates included: a release brings it to generated projects.
    separateMajorMinor: false,
    packageRules: [
        {
            matchFileNames: ["template/**"],
            groupName: "template",
            semanticCommitType: "fix",
        },
    ],
}
