{
    $schema: "https://docs.renovatebot.com/renovate-schema.json",
    extends: ["config:recommended"],
    dependencyDashboard: false,
    // Commits made through the GitHub API are signed (Verified).
    platformCommit: "enabled",
    semanticCommits: "enabled",
    // brigade is generated by brigade: its generated files follow the template
    // through a release and mise run brigade:update, like any project.
    ignorePaths: [
        // Globs, anchored: a plain string would also match template/.mise/config.toml.
        ".mise/{config.toml,conf.d/**}",
        ".github/actions/**",
        ".github/workflows/{lint,build,test,release,deploy,operate}.yml",
    ],
    // Template files have Jinja names, which the default file patterns do not match.
    mise: {
        // Tool fragments are Jinja: a customManagers entry reads their pins.
        managerFilePatterns: ["/(^|/)\\.mise/conf\\.d/[^/]*(\\.toml|\\{% endif %\\})$/"],
    },
    "github-actions": {
        managerFilePatterns: ["/^template/.*/workflows/[^/]*(\\.yml|\\{% endif %\\})$/", "/^template/.*/actions/[^/]+/action\\.yml$/"],
    },
    gitlabci: {
        managerFilePatterns: ["/^template/.*\\.gitlab[^/]*/ci/[^/]+\\.yml/"],
    },
    customManagers: [
        {
            // Python tools pinned inside commands
            customType: "regex",
            managerFilePatterns: [
                "/^template/\\.mise/config\\.toml$/",
                "/^template/\\.mise/conf\\.d/.*tool-ctt.*\\.jinja$/",
                "/^ctt\\.toml$/",
                "/^README\\.md$/",
                "/^\\.mise/scripts/[^/]+\\.py$/",
            ],
            matchStrings: ["(?<depName>copier-template-tester|copier|pytest)(?:==|@)(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
            datasourceTemplate: "pypi",
        },
        {
            // mise installed by its script (Gitea/Forgejo action)
            customType: "regex",
            managerFilePatterns: ["/^template/.*/actions/[^/]+/action\\.yml$/"],
            matchStrings: ["MISE_VERSION=v(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
            depNameTemplate: "jdx/mise",
            datasourceTemplate: "github-releases",
            extractVersionTemplate: "^v(?<version>.*)$",
        },
        {
            // Tool fragments: the version is brigade's default in the Jinja file.
            customType: "regex",
            managerFilePatterns: ["/^template/\\.mise/conf\\.d/.+\\.jinja$/"],
            matchStrings: ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[^\\n]*default\\('(?<currentValue>[^']+)', true\\)"],
            extractVersionTemplate: "^v?(?<version>.*)$",
        },
        {
            customType: "regex",
            managerFilePatterns: ["/^\\.copier/settings\\.yml$/"],
            matchStrings: ["_min_copier_version: \"(?<currentValue>[^\"]+)\""],
            depNameTemplate: "copier",
            datasourceTemplate: "pypi",
        },
    ],
    // Two grouped PRs: template updates reach generated projects and trigger a release (fix),
    // updates of this repo's own tooling do not (chore).
    packageRules: [
        {
            matchFileNames: ["template/**"],
            groupName: "template",
            semanticCommitType: "fix",
        },
        {
            matchFileNames: ["!template/**"],
            groupName: "tooling",
            semanticCommitType: "chore",
        },
    ],
}
