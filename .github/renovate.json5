{
    $schema: "https://docs.renovatebot.com/renovate-schema.json",
    extends: ["config:recommended"],
    dependencyDashboard: false,
    semanticCommits: "enabled",
    // Merged once the required checks pass (GitHub auto-merge); a failing check,
    // or Copier's conflict markers in a brigade update, keep the PR open.
    automerge: true,
    // Only the template: generated projects, brigade included, get its versions
    // through a release and mise run brigade:update, which Renovate runs in a PR
    // on each release (brigade's own answers file, see the renovate tool).
    includePaths: ["template/**", ".brigade/answers.yml"],
    // Template files have Jinja names, which the default file patterns do not match.
    mise: {
        // Tool fragments are Jinja: a customManagers entry reads their pins.
        managerFilePatterns: ["/^template/\\.brigade/(tools/)?[^/]*(\\.toml|\\{% endif %\\})$/"],
    },
    "github-actions": {
        managerFilePatterns: ["/^template/.*/workflows/[^/]*(\\.yml|\\{% endif %\\})(\\.jinja)?$/", "/^template/.*/actions/[^/]+/action\\.yml$/"],
    },
    gitlabci: {
        managerFilePatterns: ["/^template/\\.brigade/ci/[^/]*gitlab[^/]*/[^/]+\\.yml/"],
    },
    customManagers: [
        {
            // Python tools pinned inside commands
            customType: "regex",
            managerFilePatterns: ["/^template/\\.brigade/mise\\.toml$/", "/^template/\\.brigade/tools/.*(ctt|molecule)-brigade.*\\.jinja$/"],
            matchStrings: ["(?<depName>copier-template-tester|copier|molecule-plugins)(?:\\[\\w+\\])?(?:==|@)(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
            datasourceTemplate: "pypi",
        },
        {
            // mise installed by its script (Gitea/Forgejo action)
            customType: "regex",
            managerFilePatterns: ["/^template/.*/actions/[^/]+/action\\.yml$/"],
            matchStrings: ["MISE_VERSION=v(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
            depNameTemplate: "jdx/mise",
            datasourceTemplate: "github-releases",
            extractVersionTemplate: "^v(?<version>.*)$",
        },
        {
            // Tool fragments: the version is brigade's default in the Jinja file.
            customType: "regex",
            managerFilePatterns: ["/^template/\\.brigade/tools/.+\\.jinja$/"],
            matchStrings: ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[^\\n]*default\\('(?<currentValue>[^']+)', true\\)"],
            extractVersionTemplate: "^v?(?<version>.*)$",
        },
    ],
    // One PR, major updates included: a release brings it to generated projects.
    separateMajorMinor: false,
    packageRules: [
        {
            matchFileNames: ["template/**"],
            groupName: "template",
            semanticCommitType: "fix",
        },
        {
            // brigade's own update: no release.
            matchDepNames: ["brigade"],
            semanticCommitType: "ci",
        },
    ],
}
