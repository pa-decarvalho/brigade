{%- set stage_jobs = jobs[stage] %}  # One CI job per job of the stage (the jobs answer: the <stage>-<name>
  # tasks), in parallel.
  run:
    name: {% raw %}${{ matrix.name }}{% endraw %}
    strategy:
      fail-fast: false
      matrix:
        include:
{%- for job in stage_jobs %}
          - name: {{ job.name }}
            task: {{ stage }}-{{ job.name }}
{%- endfor %}
