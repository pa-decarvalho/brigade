{%- set jobs = {
  'lint': lint_jobs, 'build': build_jobs, 'test': test_jobs,
  'release': release_jobs, 'deploy': deploy_jobs, 'operate': operate_jobs,
}[stage] %}  # One job per command of the stage (<stage>_jobs: the <stage>-<n>
  # tasks), in parallel.
  run:
    name: {% raw %}${{ matrix.name }}{% endraw %}
    strategy:
      fail-fast: false
      matrix:
        include:
{%- for job in jobs %}
          - name: {{ job | tojson }}
            task: {{ stage }}-{{ loop.index }}
{%- endfor %}
