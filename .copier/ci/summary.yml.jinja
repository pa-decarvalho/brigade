  # The stage's check (branch protection): all its jobs passed.
  {{ stage }}:
    # Skipped with its jobs (release, on a branch other than the default one).
    if: always() && needs.run.result != 'skipped'
    needs: [run]
    runs-on: ubuntu-latest
    permissions: {}
    timeout-minutes: 5
    steps:
      - shell: bash
        env:
          RUN: {% raw %}${{ needs.run.result }}{% endraw %}
        run: test "$RUN" = success
