{% raw %}---
# brigade-owned: updated by mise run brigade:update, do not edit.
# Runs on pushes to the default branch: mise run release.
name: Release

# Any branch, since the default branch cannot be named here: the job checks it.
on:
  push:
    branches: ["**"]

# A new run waits for the running one: no half-done release. Per branch, so
# a push to another branch does not replace a pending release.
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false

jobs:
{% endraw %}{% with stage = 'release' %}{% if stage in split_stages %}{% include '.copier/ci/run.yml.jinja' %}{% else %}{% raw %}  release:
{% endraw %}{% endif %}{% raw %}    if: github.ref_name == github.event.repository.default_branch
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: write
      issues: write # release PR labels
      pull-requests: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: true # releasaurus's git operations
      - uses: ./.brigade/ci/gitea/actions/release
{% endraw %}{% raw %}        with:
{% endraw %}{% if stage in split_stages %}{% raw %}          task: ${{ matrix.task }}
{% endraw %}{% endif %}{% raw %}          # Optional bot token, else the workflow token.
          token: ${{ secrets.RELEASAURUS_{% endraw %}{{ ci | upper }}{% raw %}_TOKEN }}
{% endraw %}{% if stage in split_stages %}{% include '.copier/ci/summary.yml.jinja' %}{% endif %}{% endwith -%}
