---
# brigade-owned: updated by mise run brigade:update, do not edit.
# mise run operate, e.g. Renovate: on manual runs ("Run workflow"),
# and on the operate_schedule answer.
name: Operate

on:
{%- if operate_schedule %}
  schedule:
    - cron: "{{ operate_schedule }}"
{%- endif %}
  workflow_dispatch:

{% raw -%}
permissions:
  contents: read

jobs:
  operate:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    env:
      GITHUB_TOKEN: ${{ github.token }}
      # Renovate: a RENOVATE_TOKEN secret, on this repository.
      RENOVATE_PLATFORM: github
      RENOVATE_REPOSITORIES: ${{ github.repository }}
      RENOVATE_TOKEN: ${{ secrets.RENOVATE_TOKEN }}
      RENOVATE_ONBOARDING: "false"
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: ./.github/actions/mise
      - run: mise run operate
{%- endraw %}
