---
# brigade-owned: updated by mise run brigade:update, do not edit.
# mise run operate, e.g. Renovate: on manual runs ("Run workflow"),
# and on the operate_schedule answer.
name: Operate

on:
{%- if operate_schedule %}
  schedule:
    - cron: "{{ operate_schedule }}"
{%- endif %}
  workflow_dispatch:

{% raw %}permissions:
  contents: read

jobs:
{% endraw %}{% with stage = 'operate' %}{% if stage in split_stages %}{% include 'template/.brigade/ci/~matrix.yml' %}{% include 'template/.brigade/ci/~run.yml' %}{% else %}{% raw %}  operate:
{% endraw %}{% endif %}{% raw %}    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: mise run operate # zizmor: ignore[self-repository]
        uses: ./.brigade/ci/github/actions/operate
        with:
{% endraw %}{% if stage in split_stages %}{% raw %}          task: ${{ matrix.task }}
          unit: ${{ matrix.unit }}
{% endraw %}{% endif %}{% raw %}          renovate-token: ${{ secrets.RENOVATE_TOKEN }}
          ansible-private-key: ${{ secrets.ANSIBLE_PRIVATE_KEY }}
          ansible-vault-password: ${{ secrets.ANSIBLE_VAULT_PASSWORD }}
{% endraw %}{% if stage in split_stages %}{% include 'template/.brigade/ci/~summary.yml' %}{% endif %}{% endwith -%}
