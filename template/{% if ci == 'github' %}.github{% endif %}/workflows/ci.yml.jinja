{%- set done = [] -%}
{%- macro steps(stage) %}
    steps:
      - uses: actions/checkout@v7.0.1
      - uses: ./.github/actions/mise
      - run: mise run {{ stage }}
{%- endmacro -%}
{%- macro needs() %}
{%- if done %}
    needs: {{ done | tojson }}
{%- endif %}
{%- endmacro -%}
---
# brigade-owned: updated by mise run brigade:update, do not edit.
# Each stage runs mise run <stage>, defined in .mise/conf.d/stages.toml.
# Other jobs: add your own workflow file.
name: CI

on:
  pull_request:
  push:
    # release runs on main (the default branch), deploy on X.Y.Z tags.
    branches: [main]
    tags: ["*.*.*"]
  # Deploy without a release, e.g. a typo in the documentation.
  workflow_dispatch:

jobs:
{%- if lint_enabled %}

  lint:{{ needs() }}
    runs-on: ubuntu-latest
    env:
      GITHUB_TOKEN: {% raw %}${{ github.token }}{% endraw %}
{{- steps('lint') }}
{%- set _ = done.append('lint') %}
{%- endif %}
{%- if build_enabled %}

  build:{{ needs() }}
    if: {% raw %}${{ !cancelled() && !failure() }}{% endraw %}
    runs-on: ubuntu-latest
    env:
      GITHUB_TOKEN: {% raw %}${{ github.token }}{% endraw %}
{{- steps('build') }}
{%- set _ = done.append('build') %}
{%- endif %}
{%- if test_enabled %}

  test:{{ needs() }}
    if: {% raw %}${{ !cancelled() && !failure() }}{% endraw %}
    runs-on: ubuntu-latest
    env:
      GITHUB_TOKEN: {% raw %}${{ github.token }}{% endraw %}
{{- steps('test') }}
{%- set _ = done.append('test') %}
{%- endif %}
{%- if release_enabled %}

  release:{{ needs() }}
    if: >-
      {% raw %}${{ !cancelled() && !failure()
      && github.event_name == 'push' && github.ref_type == 'branch' }}{% endraw %}
    runs-on: ubuntu-latest
    env:
      GITHUB_TOKEN: {% raw %}${{ github.token }}{% endraw %}
      RELEASAURUS_FORGE: github
      RELEASAURUS_REPO: {% raw %}${{ github.server_url }}/${{ github.repository }}{% endraw %}
      # A bot token: tags pushed with the workflow token start no CI.
      RELEASAURUS_GITHUB_TOKEN: {% raw %}${{ secrets.RELEASAURUS_GITHUB_TOKEN }}{% endraw %}
{{- steps('release') }}
{%- set _ = done.append('release') %}
{%- endif %}
{%- if deploy_enabled %}

  deploy:{{ needs() }}
    if: >-
      {% raw %}${{ !cancelled() && !failure()
      && (startsWith(github.ref, 'refs/tags/')
      || github.event_name == 'workflow_dispatch') }}{% endraw %}
    runs-on: ubuntu-latest
    permissions:
      contents: write  # pages:deploy pushes the gh-pages branch
    env:
      GITHUB_TOKEN: {% raw %}${{ github.token }}{% endraw %}
      GIT_COMMITTER_NAME: {% raw %}${{ github.actor }}{% endraw %}
      GIT_COMMITTER_EMAIL: {% raw %}${{ github.actor }}{% endraw %}@users.noreply.github.com
{{- steps('deploy') }}
{%- endif %}
