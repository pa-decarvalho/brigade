---
# brigade-owned: updated by mise run brigade:update, do not edit.
# Runs on pull requests: mise run lint (.brigade/stages.toml).
name: Lint

on:
  pull_request:

permissions:
  contents: read

concurrency:
  # One group per pull request (its ref): a new push cancels the older run.
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  lint:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: mise run lint  # zizmor: ignore[self-repository]
        uses: ./.brigade/ci/github/actions/lint
