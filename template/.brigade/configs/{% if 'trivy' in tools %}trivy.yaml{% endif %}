---
# Trivy config: trivy fs --config .brigade/configs/trivy.yaml .
# brigade-owned: updated by mise run brigade:update.
# For your own settings, set trivy_config to your file.
# It replaces the project's trivy.yaml. Paths are relative to the project root.
quiet: true
exit-code: 1
scan:
  skip-dirs:
    # The GitLab CI tool cache, and mise's lock sidecars (tools' dependencies).
    - .mise-data
    - "**/.mise"
