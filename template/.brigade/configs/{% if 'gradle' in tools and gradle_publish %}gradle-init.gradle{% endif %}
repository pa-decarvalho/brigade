// Gradle init script of gradle:deploy: gradle --init-script .brigade/configs/gradle-init.gradle
// brigade-owned: updated by mise run brigade:update.
// For your own script, set gradle_config to your file (start from a copy).
//
// With MAVEN_REPOSITORY_URL set, each project applying maven-publish gets a
// repository "brigade" at that URL, logged in with MAVEN_USERNAME and
// MAVEN_PASSWORD: gradle publish publishes there too. Else nothing changes.
def url = System.getenv('MAVEN_REPOSITORY_URL')
if (url) {
    allprojects {
        plugins.withId('maven-publish') {
            publishing.repositories.maven {
                name = 'brigade'
                setUrl(url)
                if (System.getenv('MAVEN_USERNAME')) {
                    credentials {
                        username = System.getenv('MAVEN_USERNAME')
                        password = System.getenv('MAVEN_PASSWORD')
                    }
                }
            }
        }
    }
}
