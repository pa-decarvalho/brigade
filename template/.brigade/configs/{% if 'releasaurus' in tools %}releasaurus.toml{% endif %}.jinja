{%- set ecosystems = {'uv': 'python', 'node': 'node', 'rust': 'rust', 'go': 'go', 'maven': 'java', 'gradle': 'java'} -%}
{%- set found = ecosystems | dictsort | selectattr(0, 'in', tools) | map(attribute=1) | unique | list -%}
{%- set release_type = releasaurus_release_type or (found[0] if found | length == 1 else 'none') -%}
# brigade-owned: updated by mise run brigade:update, do not edit.
# For your own settings, set releasaurus_config to your file (keep tag_prefix = "").

# Release on feat, fix, perf, revert and breaking changes only: other commits
# are left out of the version and CHANGELOG.md.
[defaults.versioning.named_parsers]
refactor.skip = true
documentation.skip = true
style.skip = true
test.skip = true
chore.skip = true
ci.skip = true
miscellaneous.skip = true

# The project, tagged X.Y.Z (no "v").
[[package]]
path = "."
tag_prefix = ""
{%- if release_type != 'none' %}
# The manifests that follow the version (releasaurus_release_type).
release_type = "{{ release_type }}"
{%- endif %}
