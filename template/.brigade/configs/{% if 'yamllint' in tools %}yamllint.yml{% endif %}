---
# yamllint config: yamllint --strict -c .brigade/configs/yamllint.yml .
# Yours: brigade created it once and never changes it.
# Paths are relative to the project root.
extends: default
ignore: |
  .venv/
  node_modules/
  .mise-data/
  .brigade/copier/
rules:
  truthy:
    check-keys: false
  new-lines: disable
  # One space before a comment, as in actions pinned by SHA:
  # uses: x@<sha> # v1.2.3
  comments:
    min-spaces-from-content: 1
