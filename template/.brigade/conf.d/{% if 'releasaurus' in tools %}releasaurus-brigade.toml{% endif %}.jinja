{%- set config = releasaurus_config or '.brigade/configs/releasaurus.toml' -%}
[tools]
# renovate: datasource=github-releases depName=robgonnella/releasaurus
"aqua:robgonnella/releasaurus" = "{{ releasaurus_version | default('1.4.0', true) }}"

# Tags and publishes a merged release PR, then opens or updates the next one.
# This order is required: release-pr fails while a merged release PR is not tagged.
# Needs RELEASAURUS_REPO, RELEASAURUS_FORGE and a token (RELEASAURUS_<FORGE>_TOKEN): CI sets them.
[tasks."releasaurus:release"]
description = "Tag and publish a merged release PR, then open or update the next one"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
# Config: .brigade/configs/releasaurus.toml (brigade's; releasaurus_config for your own), read
# from the default branch through the forge's API.
run = '''{{ releasaurus_release_command | default("releasaurus release --config " ~ config ~ " && releasaurus release-pr --config " ~ config, true) }}'''
