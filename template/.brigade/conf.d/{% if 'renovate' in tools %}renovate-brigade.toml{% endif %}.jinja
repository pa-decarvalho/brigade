{%- set config = renovate_config or '.brigade/configs/renovate.json' -%}
[tools]
# re2's install script (Renovate's) must run with this node, not the system's (its native
# binary is built for one Node.js version).
# renovate: datasource=node-version depName=node
node = "{{ renovate_node_version | default('26.13.1', true) }}"
# renovate: datasource=pypi depName=check-jsonschema
"pipx:check-jsonschema" = { version = "{{ renovate_version | default('0.39.0', true) }}", python = "3.14", uvx_args = "--with json5" }
# In [tools], not on renovate:operate: mise locks [tools] only, so its checksums are in
# .brigade/mise.lock (every job installs it; CI's mise cache keeps that short).
# @yarnpkg/libzip 3.2.2 has no npm provenance (manual publish of yarnpkg/berry's 2eb9830 release),
# which mise's trust policy rejects: exempt that one version only. re2 (RE2 regexes, as Renovate
# validates them) installs its native binary with a script, which runs only when allowed.
# renovate: datasource=npm depName=renovate
"npm:renovate" = { version = "{{ renovate_cli_version | default('44.262.2', true) }}", trust_policy_excludes = ["@yarnpkg/libzip@3.2.2"], allow_builds = ["re2"] }

[tasks."renovate:lint"]
description = "Check the Renovate config"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
# The project's Renovate config wherever Renovate reads it (renovate.json, .github/renovate.json5,
# .renovaterc...), which adds to brigade's: none passes.
run = '''{{ renovate_lint_command | default('uv run --no-project python .brigade/scripts/brigade_files.py "renovate.json*" ".*/renovate.json*" ".renovaterc*" -- check-jsonschema --builtin-schema vendor.renovate --default-filetype json5', true) }}'''

# Runs Renovate (needs RENOVATE_TOKEN and RENOVATE_REPOSITORIES: CI sets them).
[tasks."renovate:operate"]
description = "Run Renovate"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
run = '''{{ renovate_operate_command | default('renovate', true) }}'''

# Its config: what it updates (renovate_updates), and brigade's updates (a PR running
# brigade:update on each release).
[tasks."renovate:operate".env]
RENOVATE_CONFIG_FILE = "{{ config }}"
