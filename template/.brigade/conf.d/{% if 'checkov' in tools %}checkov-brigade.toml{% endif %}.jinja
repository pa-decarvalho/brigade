{%- set config = checkov_config or '.brigade/configs/checkov.yml' -%}
[tools]
# renovate: datasource=pypi depName=checkov
"pipx:checkov" = { version = "{{ checkov_version | default('3.4.6', true) }}", python = "3.14" }

[tasks."checkov:lint"]
description = "Check infrastructure code (Terraform, Kubernetes, Dockerfiles, workflows...) for misconfigurations with Checkov"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
# Config: .brigade/configs/checkov.yml (brigade's; checkov_config for your own).
run = '''{{ checkov_lint_command | default('checkov --config-file ' ~ config, true) }}'''
