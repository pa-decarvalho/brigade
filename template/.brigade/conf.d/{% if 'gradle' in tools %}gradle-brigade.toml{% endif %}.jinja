{%- set config = gradle_config or '.brigade/configs/gradle-init.gradle' -%}
[tools]
# Eclipse Temurin: mise matches the pin's prefix (temurin-25.0.5+8.0.LTS). With maven too,
# keep both Java versions the same: one of them wins.
# renovate: datasource=java-version depName=java-jdk
java = "temurin-{{ gradle_java_version | default('25.0.5+8', true) }}"
# renovate: datasource=gradle-version depName=gradle
gradle = "{{ gradle_version | default('9.9.2', true) }}"

# Gradle runs the project's build (settings.gradle.kts...), not its wrapper (gradlew); it
# writes build/ and .gradle/ (ignore them) and downloads to ~/.gradle (not cached in CI).

[tasks."gradle:build"]
description = "Build the Java project with Gradle, without its tests (gradle assemble)"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
run = '''{{ gradle_build_command | default('gradle --console=plain assemble', true) }}'''

[tasks."gradle:test"]
description = "Build the Java project and run its tests and checks (gradle check)"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
run = '''{{ gradle_test_command | default('gradle --console=plain check', true) }}'''
{%- if gradle_publish %}

[tasks."gradle:publish"]
description = "Publish the artifacts to a Maven repository (gradle publish)"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
# The project applies maven-publish with its publications. The repository: MAVEN_REPOSITORY_URL,
# added by the init script, else the project's own; its login: the MAVEN_USERNAME and
# MAVEN_PASSWORD secrets.
run = '''{{ gradle_publish_command | default('gradle --console=plain --init-script ' ~ config ~ ' publish', true) }}'''
{%- endif %}
