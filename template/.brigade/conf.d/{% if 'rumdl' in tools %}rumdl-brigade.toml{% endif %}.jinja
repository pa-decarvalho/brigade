{%- set config = rumdl_config or '.brigade/configs/rumdl.toml' -%}
[tools]
# renovate: datasource=github-releases depName=rvben/rumdl
rumdl = "{{ rumdl_version | default('0.3.6', true) }}"

[tasks."rumdl:lint"]
description = "Check Markdown files with rumdl"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
# Config: .brigade/configs/rumdl.toml (brigade's; rumdl_config for your own).
run = '''{{ rumdl_lint_command | default("rumdl check --no-cache --config " ~ config ~ " .", true) }}'''
