[tools]
# renovate: datasource=github-releases depName=goreleaser/goreleaser
"aqua:goreleaser/goreleaser" = "{{ goreleaser_version | default('2.20.3', true) }}"

[tasks."goreleaser:publish"]
description = "Build the Go binaries and attach them to the release with GoReleaser"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
# Config: .brigade/configs/goreleaser.yaml (the project's). Needs Go (the go tool) and the tag
# at HEAD; adds the archives to the release Releasaurus made (GITHUB_TOKEN, or GITLAB_TOKEN). A
# change to mise's lockfile alone is allowed (allow_lock_changes.py: --skip=validate, which also
# skips GoReleaser's tag checks).
run = '''{{ goreleaser_publish_command | default('uv run --no-project python .brigade/scripts/allow_lock_changes.py --skip=validate goreleaser release --clean -f .brigade/configs/goreleaser.yaml', true) }}'''
