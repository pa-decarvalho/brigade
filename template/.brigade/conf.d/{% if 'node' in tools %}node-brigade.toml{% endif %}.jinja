[tools]
# renovate: datasource=node-version depName=node
node = "{{ node_version | default('26.13.1', true) }}"

# npm installs the project's dependencies from package-lock.json (npm ci), then runs its
# package.json scripts; a missing script does nothing (--if-present).

[tasks."node:lint"]
description = "Install the dependencies and run the lint script (ESLint...)"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
# For linters whose config and plugins are project dependencies (ESLint).
run = '''{{ node_lint_command | default('npm ci && npm run lint --if-present', true) }}'''

[tasks."node:build"]
description = "Install the dependencies and run the build script"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
run = '''{{ node_build_command | default('npm ci && npm run build --if-present', true) }}'''

[tasks."node:test"]
description = "Install the dependencies and run the test script"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
run = '''{{ node_test_command | default('npm ci && npm test --if-present', true) }}'''
{%- if npm_publish %}

[tasks."node:publish"]
description = "Install the dependencies and publish the package to its registry"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
# The registry: npm's, or publishConfig in package.json; its token: the NPM_TOKEN secret,
# read by a line of the project's .npmrc (//registry.npmjs.org/:_authToken=${NPM_TOKEN}).
run = '''{{ node_publish_command | default('npm ci && npm publish', true) }}'''
{%- endif %}
