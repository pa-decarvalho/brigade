[tools]
"aqua:jdx/jactionlint" = "2.6.0"
# jactionlint checks run: scripts with the shellcheck in PATH: pinned, so local runs match CI's.
shellcheck = "0.11.0"

[tasks."jactionlint:lint"]
description = "Check Gitea/Forgejo workflows and actions with jactionlint"
dir = "{{config_root}}/../.."
# .gitea/ or .forgejo/ (the ci answer). Only this project's files (not the copies in
# subfolders); Python globs on every OS.
run = '''uv run --no-project python .brigade/scripts/brigade_files.py ".gitea/workflows/*.yml" ".forgejo/workflows/*.yml" ".brigade/ci/gitea/actions/*/action.yml" -- jactionlint'''
