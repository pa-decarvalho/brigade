[tools]
# Installs rustup first if needed (or uses the machine's), then this toolchain with
# rustfmt and Clippy, whatever rustup's profile (CI runners: minimal).
# renovate: datasource=github-releases depName=rust-lang/rust
rust = { version = "{{ rust_version | default('1.100.0', true) }}", components = ["rustfmt", "clippy"] }

[tasks."rust:lint"]
description = "Check the formatting and run Clippy"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
run = '''{{ rust_lint_command | default('cargo fmt --check && cargo clippy --all-targets -- -D warnings', true) }}'''

[tasks."rust:build"]
description = "Build the Rust crates"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
run = '''{{ rust_build_command | default('cargo build', true) }}'''

[tasks."rust:test"]
description = "Run the Rust tests"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
run = '''{{ rust_test_command | default('cargo test', true) }}'''
{%- if cargo_publish %}

[tasks."rust:publish"]
description = "Publish the crate to its registry"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
# The registry: crates.io, or publish = [...] in Cargo.toml; its token: the
# CARGO_REGISTRY_TOKEN secret, which cargo reads.
run = '''{{ rust_publish_command | default('cargo publish', true) }}'''
{%- endif %}
