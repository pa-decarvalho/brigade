[tools]
# renovate: datasource=github-releases depName=j178/prek
prek = "{{ prek_version | default('0.5.11', true) }}"

# Git hooks, for local use: not a pipeline stage. Config: .brigade/configs/prek.yaml (the
# project's: its hooks, pre-commit's format). The hook calls this prek by its install path, so
# run prek:install again after a prek version change. --force replaces the hooks already there
# (the hook of brigade 0.25 and earlier, a hand-written one: move it to prek.yaml, repo: local).
[tasks."prek:install"]
description = "Install the git hooks of .brigade/configs/prek.yaml (pre-commit: mise run lint)"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
run = '''{{ prek_install_command | default('prek install --force -c .brigade/configs/prek.yaml', true) }}'''

[tasks."prek:run"]
description = "Run the hooks of .brigade/configs/prek.yaml on every file"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
run = '''{{ prek_run_command | default('prek run --all-files -c .brigade/configs/prek.yaml', true) }}'''
