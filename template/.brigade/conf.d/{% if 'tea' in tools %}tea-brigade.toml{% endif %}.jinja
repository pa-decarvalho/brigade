{#- The checks besides the merge method, from the selected tools; forgejo for its secrets' names. -#}
{%- set checks = ['releasaurus', 'renovate'] | select('in', tools) | list + (['forgejo'] if ci == 'forgejo' else []) -%}
[tools]
# Released on gitea.com, which mise reads as a Forgejo forge (same API).
# renovate: datasource=gitea-releases depName=gitea/tea
"forgejo:gitea/tea" = { version = "{{ tea_version | default('0.16.0', true) }}", api_url = "https://gitea.com/api/v1" }

# Not a stage name: stays out of the pipeline. Needs your login (tea login add).
[tasks."tea:check"]
description = "Check the Gitea or Forgejo repository's settings for the selected tools"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
run = '''{{ tea_check_command | default(('uv run --no-project python .brigade/scripts/repo_check.py tea ' ~ checks | join(' ')) | trim, true) }}'''

# Changes the missing settings that need no secret value, and reports the others.
[tasks."tea:setup"]
description = "Change the Gitea or Forgejo repository's settings for the selected tools"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
run = '''{{ tea_setup_command | default(('uv run --no-project python .brigade/scripts/repo_check.py --apply tea ' ~ checks | join(' ')) | trim, true) }}'''
