{%- set config = yamllint_config or '.brigade/configs/yamllint.yml' -%}
[tools]
# renovate: datasource=pypi depName=yamllint
"pipx:yamllint" = { version = "{{ yamllint_version | default('1.38.0', true) }}", python = "3.14" }

[tasks."yamllint:lint"]
description = "Check YAML files with yamllint"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
# Config: .brigade/configs/yamllint.yml (brigade's; yamllint_config for your own).
run = '''{{ yamllint_lint_command | default('yamllint --strict -c ' ~ config ~ ' .', true) }}'''
