[tools]
# renovate: datasource=pypi depName=clang-format
"pipx:clang-format" = { version = "{{ clang_format_version | default('23.1.5', true) }}", python = "3.14" }

[tasks."clang-format:lint"]
description = "Check C and C++ formatting with clang-format"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
# Every C/C++ file outside hidden folders; style from the project's .clang-format (else LLVM).
run = '''{{ clang_format_lint_command | default('uv run --no-project python .brigade/scripts/brigade_files.py "**/*.c" "**/*.h" "**/*.cc" "**/*.cpp" "**/*.cxx" "**/*.hh" "**/*.hpp" "**/*.hxx" -- clang-format --dry-run --Werror', true) }}'''
