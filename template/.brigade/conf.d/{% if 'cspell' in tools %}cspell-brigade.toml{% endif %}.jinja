{%- set config = cspell_config or '.brigade/configs/cspell.yaml' -%}
[tools]
# renovate: datasource=node-version depName=node
node = "{{ cspell_node_version | default('26.13.1', true) }}"
# renovate: datasource=npm depName=cspell
"npm:cspell" = "{{ cspell_version | default('10.5.2', true) }}"

[tasks."cspell:lint"]
description = "Check spelling with cspell"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
# Config: .brigade/configs/cspell.yaml (brigade's; cspell_config for your own); your words go in
# your cspell.json, read too. Skips hidden folders.
run = '''{{ cspell_lint_command | default('cspell lint --no-progress --no-must-find-files -c ' ~ config ~ ' .', true) }}'''
