{%- if ci == 'github' -%}
[tools]
# renovate: datasource=pypi depName=ghp-import
"pipx:ghp-import" = { version = "{{ pages_version | default('2.1.0', true) }}", python = "3.14" }

{% endif -%}
[tasks."pages:deploy"]
description = "Publish {{ pages_dir }}/, built by the *:build tasks, to Pages"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
# Any build writing {{ pages_dir }}/ (the pages_dir answer: zensical:build, node:build, your own
# task); CI deploys on a fresh runner.
depends = [{ task = "*:build", optional = true }]
{%- if ci == 'github' or pages_deploy_command %}
run = '''{{ pages_deploy_command | default('ghp-import -n -p -f ' ~ pages_dir, true) }}'''
{%- endif %}
