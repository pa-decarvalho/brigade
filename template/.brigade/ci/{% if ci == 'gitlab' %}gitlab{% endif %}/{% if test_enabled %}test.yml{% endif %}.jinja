---
# Runs in merge request pipelines, next to the other stages.
{%- if 'test' in split_stages %}
# A split stage (a tool's matrix): test-matrix writes one job per task
# (.brigade/scripts/ci_jobs.py; in .mise-data/, the GitLab tool cache, which
# the linters skip), and test runs them as a child pipeline.
test-matrix:
  stage: test
  needs: []
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  before_script:
    - mise trust
  script:
    - >-
      mise exec uv -- uv run --no-project python
      .brigade/scripts/ci_jobs.py test --gitlab .mise-data/test-jobs.yml
  artifacts:
    paths:
      - .mise-data/test-jobs.yml
{%- endif %}
test:
  stage: test
  needs: {% if 'test' in split_stages %}[test-matrix]{% else %}[]{% endif %}
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
{%- if 'test' in split_stages %}
  trigger:
    include:
      - artifact: .mise-data/test-jobs.yml
        job: test-matrix
    strategy: depend
{%- else %}
  script:
    - mise run test
{%- endif %}
