---
# Runs in merge request pipelines, next to the other stages.
test:
  stage: test
  needs: []
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
{%- if 'test' in split_stages %}
  # One job per command of the stage (the jobs answer: the test-<name> tasks).
  parallel:
    matrix:
      - TASK: [{% for job in jobs['test'] %}test-{{ job.name }}{{ ', ' if not loop.last else '' }}{% endfor %}]
  script:
    - mise run "$TASK"
{%- else %}
  script:
    - mise run test
{%- endif %}
