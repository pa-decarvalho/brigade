---
# Runs in merge request pipelines, next to the other stages.
build:
  stage: build
  needs: []
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
{%- if 'build' in split_stages %}
  # One job per command of the stage (the jobs answer: the build-<name> tasks).
  parallel:
    matrix:
      - TASK: [{% for job in jobs['build'] %}build-{{ job.name }}{{ ', ' if not loop.last else '' }}{% endfor %}]
  script:
    - mise run "$TASK"
{%- else %}
  script:
    - mise run build
{%- endif %}
