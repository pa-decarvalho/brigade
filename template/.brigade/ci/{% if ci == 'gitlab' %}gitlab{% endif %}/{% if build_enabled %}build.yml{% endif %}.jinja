---
# Runs in merge request pipelines, next to the other stages.
{%- if ci_jobs == 'tool' %}
# ci_jobs tool: build-plan writes one job per task, build runs them
# as a child pipeline (.brigade/scripts/ci_jobs.py; in .mise-data/, the
# GitLab tool cache, which the linters skip).
build-plan:
  stage: build
  needs: []
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  before_script:
    - mise trust
  script:
    - >-
      mise exec uv -- uv run --no-project python
      .brigade/scripts/ci_jobs.py build --gitlab .mise-data/build-jobs.yml
  artifacts:
    paths:
      - .mise-data/build-jobs.yml
{%- endif %}
build:
  stage: build
  needs: {% if ci_jobs == 'tool' %}[build-plan]{% else %}[]{% endif %}
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
{%- if ci_jobs == 'tool' %}
  trigger:
    include:
      - artifact: .mise-data/build-jobs.yml
        job: build-plan
    strategy: depend
{%- else %}
  script:
    - mise run build
{%- endif %}
