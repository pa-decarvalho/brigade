---
# Runs in merge request pipelines, next to the other stages.
lint:
  stage: lint
  needs: []
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
{%- if 'lint' in split_stages %}
  # One job per command of the stage (lint_jobs: the lint-<n> tasks).
  parallel:
    matrix:
      - TASK: [{% for job in lint_jobs %}lint-{{ loop.index }}{{ ', ' if not loop.last else '' }}{% endfor %}]
  script:
    - mise run "$TASK"
{%- else %}
  script:
    - mise run lint
{%- endif %}
