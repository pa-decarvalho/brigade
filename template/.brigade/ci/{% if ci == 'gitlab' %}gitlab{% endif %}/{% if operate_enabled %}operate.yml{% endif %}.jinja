---
# Scheduled pipelines only (CI/CD > Schedules, "Play" to run it now):
# mise run operate, e.g. Renovate with a RENOVATE_TOKEN CI/CD variable.
{%- if 'operate' in split_stages %}
# A split stage (a tool's matrix): operate-matrix writes one job per task
# (.brigade/scripts/ci_jobs.py; in .mise-data/, the GitLab tool cache, which
# the linters skip), and operate runs them as a child pipeline.
operate-matrix:
  stage: operate
  needs: []
  rules:
    - if: $CI_PIPELINE_SOURCE == "schedule"
  before_script:
    - mise trust
  script:
    - >-
      mise exec uv -- uv run --no-project python
      .brigade/scripts/ci_jobs.py operate --gitlab .mise-data/operate-jobs.yml
  artifacts:
    paths:
      - .mise-data/operate-jobs.yml
{%- endif %}
operate:
  stage: operate
  needs: {% if 'operate' in split_stages %}[operate-matrix]{% else %}[]{% endif %}
  rules:
    - if: $CI_PIPELINE_SOURCE == "schedule"
  variables:
    RENOVATE_PLATFORM: gitlab
    RENOVATE_ENDPOINT: $CI_API_V4_URL
    RENOVATE_REPOSITORIES: $CI_PROJECT_PATH
    RENOVATE_ONBOARDING: "false"
{%- if 'operate' in split_stages %}
  trigger:
    include:
      - artifact: .mise-data/operate-jobs.yml
        job: operate-matrix
    strategy: depend
{%- else %}
  script:
    - mise run operate
{%- endif %}
