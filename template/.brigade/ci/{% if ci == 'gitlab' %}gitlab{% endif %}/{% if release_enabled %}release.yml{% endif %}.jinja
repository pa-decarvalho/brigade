---
# Releasaurus needs a RELEASAURUS_GITLAB_TOKEN CI/CD variable
# (api, write_repository).
release:
  stage: release
  rules:
    - if: >-
        $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
        && $CI_PIPELINE_SOURCE == "push"
  variables:
    RELEASAURUS_FORGE: gitlab
    RELEASAURUS_REPO: $CI_PROJECT_URL
{%- if 'release' in split_stages %}
  # One job per command of the stage (the jobs answer: the release-<name> tasks).
  parallel:
    matrix:
      - TASK: [{% for job in jobs['release'] %}release-{{ job.name }}{{ ', ' if not loop.last else '' }}{% endfor %}]
  script:
    - mise run "$TASK"
{%- else %}
  script:
    - mise run release
{%- endif %}
