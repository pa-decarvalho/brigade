---
{%- if 'deploy' in split_stages and 'pages' not in tools %}
# A split stage (a tool's matrix): deploy-matrix writes one job per task
# (.brigade/scripts/ci_jobs.py; in .mise-data/, the GitLab tool cache, which
# the linters skip), and deploy runs them as a child pipeline.
deploy-matrix:
  stage: deploy
  rules:
    - if: $CI_COMMIT_TAG =~ /^v?\d+\.\d+\.\d+$/
    # "Run pipeline": deploy without a release, e.g. a typo in the docs.
    - if: $CI_PIPELINE_SOURCE == "web"
  before_script:
    - mise trust
  script:
    - >-
      mise exec uv -- uv run --no-project python
      .brigade/scripts/ci_jobs.py deploy --gitlab .mise-data/deploy-jobs.yml
  artifacts:
    paths:
      - .mise-data/deploy-jobs.yml
{%- endif %}
deploy:
  stage: deploy
{%- if 'deploy' in split_stages and 'pages' not in tools %}
  needs: [deploy-matrix]
{%- endif %}
  rules:
    - if: $CI_COMMIT_TAG =~ /^v?\d+\.\d+\.\d+$/
    # "Run pipeline": deploy without a release, e.g. a typo in the docs.
    - if: $CI_PIPELINE_SOURCE == "web"
{%- if 'deploy' in split_stages and 'pages' not in tools %}
  trigger:
    include:
      - artifact: .mise-data/deploy-jobs.yml
        job: deploy-matrix
    strategy: depend
{%- else %}
  script:
    - mise run deploy
{%- endif %}
{%- if 'pages' in tools %}
  pages:
    publish: {{ pages_dir }}
{%- endif %}
