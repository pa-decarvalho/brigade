---
deploy:
  stage: deploy
  rules:
    - if: $CI_COMMIT_TAG =~ /^v?\d+\.\d+\.\d+$/
    # "Run pipeline": deploy without a release, e.g. a typo in the docs.
    - if: $CI_PIPELINE_SOURCE == "web"
{%- if 'deploy' in split_stages and 'pages' not in tools %}
  # One job per command of the stage (deploy_jobs: the deploy-<n> tasks).
  parallel:
    matrix:
      - TASK: [{% for job in deploy_jobs %}deploy-{{ loop.index }}{{ ', ' if not loop.last else '' }}{% endfor %}]
  script:
    - mise run "$TASK"
{%- else %}
  script:
    - mise run deploy
{%- endif %}
{%- if 'pages' in tools %}
  pages:
    publish: {{ pages_dir }}
{%- endif %}
