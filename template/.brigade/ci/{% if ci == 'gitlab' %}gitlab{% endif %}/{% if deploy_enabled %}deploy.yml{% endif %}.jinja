---
{%- if ci_jobs == 'tool' and 'pages' not in tools %}
# ci_jobs tool: deploy-plan writes one job per task, deploy runs them
# as a child pipeline (.brigade/scripts/ci_jobs.py; in .mise-data/, the
# GitLab tool cache, which the linters skip).
deploy-plan:
  stage: deploy
  rules:
    - if: $CI_COMMIT_TAG =~ /^v?\d+\.\d+\.\d+$/
    # "Run pipeline": deploy without a release, e.g. a typo in the docs.
    - if: $CI_PIPELINE_SOURCE == "web"
  before_script:
    - mise trust
  script:
    - >-
      mise exec uv -- uv run --no-project python
      .brigade/scripts/ci_jobs.py deploy --gitlab .mise-data/deploy-jobs.yml
  artifacts:
    paths:
      - .mise-data/deploy-jobs.yml
{%- endif %}
deploy:
  stage: deploy
{%- if ci_jobs == 'tool' and 'pages' not in tools %}
  needs: [deploy-plan]
{%- endif %}
  rules:
    - if: $CI_COMMIT_TAG =~ /^v?\d+\.\d+\.\d+$/
    # "Run pipeline": deploy without a release, e.g. a typo in the docs.
    - if: $CI_PIPELINE_SOURCE == "web"
{%- if ci_jobs == 'tool' and 'pages' not in tools %}
  trigger:
    include:
      - artifact: .mise-data/deploy-jobs.yml
        job: deploy-plan
    strategy: depend
{%- else %}
  script:
    - mise run deploy
{%- endif %}
{%- if 'pages' in tools %}
  pages:
    publish: {{ pages_dir }}
{%- endif %}
