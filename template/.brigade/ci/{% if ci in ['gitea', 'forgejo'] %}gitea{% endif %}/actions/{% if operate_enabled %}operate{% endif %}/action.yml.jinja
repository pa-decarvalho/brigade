{% raw %}---
# brigade-owned: updated by mise run brigade:update, do not edit.
name: operate
description: mise run operate (e.g. Renovate), with the project's tools
inputs:
  task:
    description: The task to run (a job of a split stage), else the stage
    default: operate
  renovate-token:
    description: Renovate's token (RENOVATE_TOKEN secret)
    default: ""
  renovate-github-com-token:
    description: github.com token (RENOVATE_GITHUB_COM_TOKEN secret)
    default: ""
  ansible-private-key:
    description: SSH private key for Ansible (ANSIBLE_PRIVATE_KEY secret)
    default: ""
  ansible-vault-password:
    description: Ansible vault password (ANSIBLE_VAULT_PASSWORD secret)
    default: ""
runs:
  using: composite
  steps:
    - uses: ./.brigade/ci/gitea/actions/mise # zizmor: ignore[self-repository]
    - shell: bash
      env:
        GITHUB_TOKEN: ${{ github.token }}
{% endraw %}        RENOVATE_PLATFORM: {{ ci }}
{% raw %}        RENOVATE_ENDPOINT: ${{ github.server_url }}/api/v1
        RENOVATE_REPOSITORIES: ${{ github.repository }}
        RENOVATE_TOKEN: ${{ inputs.renovate-token }}
        RENOVATE_ONBOARDING: "false"
        RENOVATE_GITHUB_COM_TOKEN: ${{ inputs.renovate-github-com-token }}
        ANSIBLE_PRIVATE_KEY: ${{ inputs.ansible-private-key }}
        ANSIBLE_VAULT_PASSWORD: ${{ inputs.ansible-vault-password }}
        TASK: ${{ inputs.task }}
      run: mise run "$TASK"{% endraw %}
