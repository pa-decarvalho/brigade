# brigade-owned: updated by mise run brigade:update, do not edit.
name: release
description: mise run release (Releasaurus), with the project's tools
inputs:
  task:
    description: The task to run (a job of a split stage), else the stage
    default: release
  token:
    description: >-
      Optional bot token: the release PR and tag made with the workflow token
      start no CI (merge the PR with a bypass, run publish by hand)
    default: ""
runs:
  using: composite
  steps:
    - uses: ./.brigade/ci/gitea/actions/mise # zizmor: ignore[self-repository]
    - shell: bash
      env:
        GITHUB_TOKEN: ${{ github.token }}
        FORGEJO_TOKEN: "" # not sent to the tools' forges (see ../mise)
{% endraw %}        RELEASAURUS_FORGE: {{ ci }}
{% raw %}        RELEASAURUS_REPO: ${{ github.server_url }}/${{ github.repository }}
{% endraw %}        RELEASAURUS_{{ ci | upper }}_TOKEN: {% raw %}${{ inputs.token || github.token }}
        TASK: ${{ inputs.task }}
      run: mise run "$TASK"{% endraw %}
