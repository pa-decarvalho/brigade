# Pipeline stages, in order. Each stage runs its jobs or its commands if it has some (in
# order), otherwise every "<tool>:<stage>" task; tools have one file each in tools/. A job
# is also a "<stage>-<n>" task, which CI runs as a job of its own.
# Tasks run at the project root: dir is relative to this file's folder.
{%- for stage, description, enabled, commands, jobs in [
  ('lint', 'static checks', lint_enabled, lint_commands, lint_jobs),
  ('build', 'build', build_enabled, build_commands, build_jobs),
  ('test', 'tests', test_enabled, test_commands, test_jobs),
  ('release', 'release (CI runs it on pushes to the default branch)', release_enabled, release_commands, release_jobs),
  ('deploy', 'deploy (CI runs it on X.Y.Z tags or on a manual run)', deploy_enabled, deploy_commands, deploy_jobs),
  ('operate', 'operate (CI runs it on manual runs, or GitLab schedules)', operate_enabled, operate_commands, operate_jobs),
] %}
{%- if enabled %}

[tasks.{{ stage }}]
description = "Stage: {{ description }}"
{% raw %}dir = "{{config_root}}/.."{% endraw %}
{%- if jobs or commands %}
run = {{ (jobs or commands) | tojson }}
{%- else %}
depends = [{ task = "*:{{ stage }}", optional = true }]
{%- endif %}
{%- for job in jobs %}

[tasks."{{ stage }}-{{ loop.index }}"]
description = "Job {{ loop.index }} of the {{ stage }} stage (CI)"
hide = true
{% raw %}dir = "{{config_root}}/.."{% endraw %}
run = {{ job | tojson }}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- if lint_enabled %}

[tasks."brigade:pre-commit"]
description = "Checks run by the git pre-commit hook"
{% raw %}dir = "{{config_root}}/.."{% endraw %}
depends = ["lint"]

[tasks."brigade:hooks"]
description = "Install a git pre-commit hook that runs mise run brigade:pre-commit"
{% raw %}dir = "{{config_root}}/.."{% endraw %}
run = "mise generate git-pre-commit --task brigade:pre-commit --write"
{%- endif %}
