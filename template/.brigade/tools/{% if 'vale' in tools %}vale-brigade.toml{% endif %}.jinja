[tools]
# renovate: datasource=github-releases depName=vale-cli/vale
"aqua:vale-cli/vale" = "{{ vale_version | default('3.27.0', true) }}"

[tasks."vale:lint"]
description = "Check prose (Markdown) with Vale"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
# Config: .brigade/configs/vale.ini (the project's). vale sync downloads the style packages it
# lists (none by default); --glob skips the GitLab CI tool cache and dependency folders.
run = '''{{ vale_lint_command | default('vale --config .brigade/configs/vale.ini sync && vale --config .brigade/configs/vale.ini "--glob=!{.mise-data,.venv,node_modules}/**" .', true) }}'''
