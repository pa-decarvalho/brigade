[tools]
# renovate: datasource=node-version depName=node
node = "{{ gitlab_ci_local_node_version | default('26.13.1', true) }}"
# renovate: datasource=npm depName=gitlab-ci-local
"npm:gitlab-ci-local" = "{{ gitlab_ci_local_version | default('4.77.1', true) }}"

# Replays the merge request pipeline in Docker. Does nothing in a GitLab pipeline (GITLAB_CI is
# set: "false" in gitlab-ci-local, where the replayed test job runs it again; "true" on GitLab).
[tasks."gitlab-ci-local:test"]
description = "Run the merge request pipeline locally with gitlab-ci-local, in Docker"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
run = '''{% raw %}{% if get_env(name="GITLAB_CI", default="") %}echo gitlab-ci-local:test: already in a GitLab pipeline{% else %}{% endraw %}{{ gitlab_ci_local_test_command | default('gitlab-ci-local --variable CI_PIPELINE_SOURCE=merge_request_event', true) }}{% raw %}{% endif %}{% endraw %}'''
