[tools]
"aqua:jdx/jactionlint" = "2.5.0"

[tasks."jactionlint:lint"]
description = "Check Gitea/Forgejo workflows and actions with jactionlint"
dir = "{{config_root}}/../.."
# Only this project's files (not the copies in subfolders); Python globs on every OS.
run = '''uv run --no-project python -c "import glob, subprocess, sys; sys.exit(subprocess.call(['jactionlint', *glob.glob('.gitea/workflows/*.yml'), *glob.glob('.brigade/ci/gitea/actions/*/action.yml')]))"'''
