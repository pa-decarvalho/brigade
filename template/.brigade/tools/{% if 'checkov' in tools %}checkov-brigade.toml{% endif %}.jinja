[tools]
# renovate: datasource=pypi depName=checkov
"pipx:checkov" = "{{ checkov_version | default('3.4.5', true) }}"

[tasks."checkov:lint"]
description = "Check infrastructure code (Terraform, Kubernetes, Dockerfiles, workflows...) for misconfigurations with Checkov"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
# Config: .brigade/configs/checkov.yml (the project's).
run = '''{{ checkov_lint_command | default('checkov --config-file .brigade/configs/checkov.yml', true) }}'''
