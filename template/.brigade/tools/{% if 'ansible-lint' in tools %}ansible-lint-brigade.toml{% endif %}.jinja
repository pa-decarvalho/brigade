[tools]
# renovate: datasource=pypi depName=ansible-lint
"pipx:ansible-lint" = "{{ ansible_lint_version | default('26.11.0', true) }}"

[tasks."ansible-lint:lint"]
description = "Check Ansible content with ansible-lint"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
# Config: .brigade/configs/ansible-lint.yml (the project's).
run = '''{{ ansible_lint_lint_command | default('ansible-lint --strict -c .brigade/configs/ansible-lint.yml', true) }}'''
