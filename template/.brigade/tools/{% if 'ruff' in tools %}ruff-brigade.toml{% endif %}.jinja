[tools]
# renovate: datasource=github-releases depName=astral-sh/ruff
ruff = "{{ ruff_version | default('0.17.5', true) }}"

[tasks."ruff:lint"]
description = "Check code and formatting with ruff"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
# Config: .brigade/configs/ruff.toml (the project's).
run = '''{{ ruff_lint_command | default('ruff check --config .brigade/configs/ruff.toml && ruff format --check --config .brigade/configs/ruff.toml', true) }}'''
