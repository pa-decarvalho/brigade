[tools]
# renovate: datasource=github-releases depName=aquasecurity/trivy
"aqua:aquasecurity/trivy" = "{{ trivy_version | default('0.76.2', true) }}"

[tasks."trivy:lint"]
description = "Check dependencies for vulnerabilities and files for secrets with Trivy"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
# Config: .brigade/configs/trivy.yaml (the project's). Downloads its vulnerability database
# (ghcr.io) into the user cache: a new vulnerability can fail an unchanged project.
run = '''{{ trivy_lint_command | default('trivy fs --config .brigade/configs/trivy.yaml .', true) }}'''
