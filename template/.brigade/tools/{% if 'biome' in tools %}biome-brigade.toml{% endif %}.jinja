[tools]
# renovate: datasource=npm depName=@biomejs/biome
"aqua:biomejs/biome" = "{{ biome_version | default('2.6.7', true) }}"

[tasks."biome:lint"]
description = "Check JavaScript, TypeScript, JSON and CSS (lint and formatting) with Biome"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
# Config: .brigade/configs/biome-brigade.jsonc (the project's; not biome.json, which Biome would
# also find as a nested root config). Nothing to check: passes.
run = '''{{ biome_lint_command | default('biome ci --no-errors-on-unmatched --config-path .brigade/configs/biome-brigade.jsonc .', true) }}'''
