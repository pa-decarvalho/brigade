[tools]
# renovate: datasource=pypi depName=zensical
"pipx:zensical" = "{{ zensical_version | default('0.1.1', true) }}"

[tasks."zensical:build"]
description = "Build the documentation site with Zensical (needs zensical.toml)"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
run = '''{{ zensical_build_command | default('zensical build --strict', true) }}'''

# Not a stage name: stays out of the pipeline.
[tasks."zensical:serve"]
description = "Preview the documentation site"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
run = '''{{ zensical_serve_command | default('zensical serve --open', true) }}'''
