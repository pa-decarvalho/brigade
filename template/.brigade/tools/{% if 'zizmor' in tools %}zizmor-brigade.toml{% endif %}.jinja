[tools]
# renovate: datasource=github-releases depName=zizmorcore/zizmor
zizmor = "{{ zizmor_version | default('1.32.0', true) }}"

[tasks."zizmor:lint"]
description = "Audit GitHub Actions workflows and actions for security issues with zizmor"
{% raw %}dir = "{{config_root}}/../.."{% endraw %}
run = '''{{ zizmor_lint_command | default('zizmor --offline .', true) }}'''
