---
# brigade-owned: updated by mise run brigade:update, do not edit.
# mise run operate, e.g. Renovate: on manual runs ("Run workflow"),
# and on the operate_schedule answer.
name: Operate

on:
{%- if operate_schedule %}
  schedule:
    - cron: "{{ operate_schedule }}"
{%- endif %}
  workflow_dispatch:

{% raw -%}
permissions:
  contents: read

jobs:
  operate:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: ./.brigade/ci/gitea/actions/operate
        with:
          renovate-token: ${{ secrets.RENOVATE_TOKEN }}
          ansible-private-key: ${{ secrets.ANSIBLE_PRIVATE_KEY }}
          ansible-vault-password: ${{ secrets.ANSIBLE_VAULT_PASSWORD }}
{%- endraw %}
