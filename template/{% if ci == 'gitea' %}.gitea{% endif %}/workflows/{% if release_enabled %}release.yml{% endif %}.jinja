{% raw %}---
# brigade-owned: updated by mise run brigade:update, do not edit.
# Runs on pushes to main (the default branch): mise run release.
name: Release

on:
  push:
    branches: [main]

# A new run waits for the running one: no half-done release.
concurrency:
  group: ${{ github.workflow }}
  cancel-in-progress: false

jobs:
{% endraw %}{% with stage = 'release' %}{% if ci_jobs == 'tool' %}{% include 'template/.brigade/ci/~plan.yml' %}{% include 'template/.brigade/ci/~run.yml' %}{% else %}{% raw %}  release:
{% endraw %}{% endif %}{% raw %}    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: write
      issues: write # release PR labels
      pull-requests: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: true # releasaurus's git operations
      - uses: ./.brigade/ci/gitea/actions/release
{% endraw %}{% raw %}        with:
{% endraw %}{% if ci_jobs == 'tool' %}{% raw %}          task: ${{ matrix.task }}
          unit: ${{ matrix.unit }}
{% endraw %}{% endif %}{% raw %}          # Optional bot token, else the workflow token.
          token: ${{ secrets.RELEASAURUS_GITEA_TOKEN }}
