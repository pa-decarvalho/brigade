---
# brigade-owned: updated by mise run brigade:update, do not edit.
# Runs on pull requests: mise run test (.brigade/stages.toml).
name: Test

on:
  pull_request:

permissions:
  contents: read

concurrency:
  # One group per pull request (its ref): a new push cancels the older run.
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: ./.brigade/ci/gitea/actions/test
