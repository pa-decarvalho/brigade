---
# brigade-owned: updated by mise run brigade:update, do not edit.
# Runs on X.Y.Z tags: mise run deploy.
name: Deploy

on:
  push:
    tags: ["*.*.*"]
  # Deploy without a release, e.g. a typo in the documentation.
  workflow_dispatch:

# A new run waits for the running one: no half-done deploy.
concurrency:
  group: ${{ github.workflow }}
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: write  # pages:deploy pushes the gh-pages branch
    env:
      GITHUB_TOKEN: ${{ github.token }}
      GIT_COMMITTER_NAME: ${{ github.actor }}
      GIT_COMMITTER_EMAIL: ${{ github.actor }}@users.noreply.github.com
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: ./.gitea/actions/mise
      - run: mise run deploy
