# Pipeline stages, in order. Each stage runs every "<tool>:<stage>" task; tools have one file
# each in .mise/conf.d/. A stage without tools is left out.
{%- if lint_stage %}

[tasks.lint]
description = "Stage: static checks"
depends = ["*:lint"]
{%- endif %}
{%- if build %}

[tasks.build]
description = "Stage: build"
depends = ["*:build"]
{%- endif %}
{%- if test %}

[tasks.test]
description = "Stage: tests"
depends = ["*:test"]
{%- endif %}
{%- if release %}

[tasks.release]
description = "Stage: publish (CI runs it on X.Y.Z tags)"
depends = ["*:release"]
{%- endif %}
{%- if deploy %}

[tasks.deploy]
description = "Stage: deploy (CI runs it on X.Y.Z tags or on a manual run)"
depends = ["*:deploy"]
{%- endif %}
{%- if lint_stage %}

[tasks."brigade:pre-commit"]
description = "Checks run by the git pre-commit hook"
depends = ["lint"]

[tasks."brigade:hooks"]
description = "Install a git pre-commit hook that runs mise run brigade:pre-commit"
run = "mise generate git-pre-commit --task brigade:pre-commit --write"
{%- endif %}
