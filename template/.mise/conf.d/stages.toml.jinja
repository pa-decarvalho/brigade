# Pipeline stages, in order. Each stage runs its commands if it has some, otherwise every
# "<tool>:<stage>" task; tools have one file each in .mise/conf.d/.
{%- for stage, description, enabled, commands in [
  ('lint', 'static checks', lint_enabled, lint_commands),
  ('build', 'build', build_enabled, build_commands),
  ('test', 'tests', test_enabled, test_commands),
  ('release', 'release (CI runs it on pushes to the default branch)', release_enabled, release_commands),
  ('deploy', 'deploy (CI runs it on X.Y.Z tags or on a manual run)', deploy_enabled, deploy_commands),
  ('operate', 'operate (CI runs it on manual runs, or GitLab schedules)', operate_enabled, operate_commands),
] %}
{%- if enabled %}

[tasks.{{ stage }}]
description = "Stage: {{ description }}"
{%- if commands %}
run = {{ commands | tojson }}
{%- else %}
depends = [{ task = "*:{{ stage }}", optional = true }]
{%- endif %}
{%- endif %}
{%- endfor %}
{%- if lint_enabled %}

[tasks."brigade:pre-commit"]
description = "Checks run by the git pre-commit hook"
depends = ["lint"]

[tasks."brigade:hooks"]
description = "Install a git pre-commit hook that runs mise run brigade:pre-commit"
run = "mise generate git-pre-commit --task brigade:pre-commit --write"
{%- endif %}
