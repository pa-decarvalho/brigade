# Downloads go through internal mirrors (Copier answers: github_mirror, pypi_index, rustup_mirror).
{%- if github_mirror %}

[settings.url_replacements]
"https://github.com/" = "{{ github_mirror.rstrip('/') }}/"
{%- endif %}
{%- if pypi_index %}

[settings.pypi]
# Index of the tools mise installs with uv (pipx backend).
registry_url = "{{ pypi_index.rstrip('/') }}/{}"
{%- endif %}
{%- if pypi_index or rustup_mirror %}

[env]
{%- if pypi_index %}
# Index of uv and uvx run by tasks.
UV_DEFAULT_INDEX = "{{ pypi_index.rstrip('/') }}"
{%- endif %}
{%- if rustup_mirror %}
RUSTUP_DIST_SERVER = "{{ rustup_mirror.rstrip('/') }}"
RUSTUP_UPDATE_ROOT = "{{ rustup_mirror.rstrip('/') }}/rustup"
{%- endif %}
{%- endif %}
