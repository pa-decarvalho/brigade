[tools]
actionlint = "1.7.12"

[tasks."actionlint:lint"]
description = "Check Gitea/Forgejo workflows with actionlint"
# actionlint only finds .github/workflows by itself; Python globs on every OS.
run = '''uv run --no-project python -c "import glob, subprocess, sys; sys.exit(subprocess.call(['actionlint', *glob.glob('.gitea/workflows/*.yml')]))"'''
