[tools]
# renovate: datasource=pypi depName=check-jsonschema
"pipx:check-jsonschema" = { version = "{{ renovate_version | default('0.39.0', true) }}", uvx_args = "--with json5" }

[tasks."renovate:lint"]
description = "Check the Renovate config"
run = '''{{ renovate_lint_command | default('check-jsonschema --builtin-schema vendor.renovate renovate.json', true) }}'''

# Runs Renovate (needs RENOVATE_TOKEN and RENOVATE_REPOSITORIES: CI sets them). Its tools are on the task, so other CI jobs skip them.
[tasks."renovate:operate"]
description = "Run Renovate"
run = '''{{ renovate_operate_command | default('renovate', true) }}'''

[tasks."renovate:operate".tools]
# renovate: datasource=node-version depName=node
node = "{{ renovate_node_version | default('26.13.0', true) }}"
# renovate: datasource=npm depName=renovate
"npm:renovate" = "{{ renovate_cli_version | default('44.227.4', true) }}"
