{%- if ci == 'github' -%}
[tools]
# renovate: datasource=pypi depName=ghp-import
"pipx:ghp-import" = "{{ pages_version | default('2.1.0', true) }}"

{% endif -%}
[tasks."pages:deploy"]
description = "Build the documentation site for Pages"
run = '''{{ pages_deploy_command | default('zensical build --strict && ghp-import -n -p -f site' if ci == 'github' else 'zensical build --strict', true) }}'''
