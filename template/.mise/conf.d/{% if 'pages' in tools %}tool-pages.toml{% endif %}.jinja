{%- if ci == 'github' -%}
[tools]
# renovate: datasource=pypi depName=ghp-import
"pipx:ghp-import" = "{{ pages_version | default('2.1.0', true) }}"

{% endif -%}
[tasks."pages:deploy"]
description = "Publish site/, built by the *:build tasks, to Pages"
# Any generator writing site/ (zensical:build, or your own task); CI deploys on a fresh runner.
depends = [{ task = "*:build", optional = true }]
{%- if ci == 'github' or pages_deploy_command %}
run = '''{{ pages_deploy_command | default('ghp-import -n -p -f site', true) }}'''
{%- endif %}
