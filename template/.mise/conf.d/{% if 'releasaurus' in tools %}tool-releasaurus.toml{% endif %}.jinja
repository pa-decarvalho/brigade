[tools]
# renovate: datasource=github-releases depName=robgonnella/releasaurus
"aqua:robgonnella/releasaurus" = "{{ releasaurus_version | default('1.3.0', true) }}"

# Opens or updates the release PR, then tags and publishes it once merged (tags X.Y.Z, no "v").
# Needs RELEASAURUS_REPO, RELEASAURUS_FORGE and a token (RELEASAURUS_<FORGE>_TOKEN): CI sets them.
[tasks."releasaurus:release"]
description = "Open the release PR, then tag and publish the release once it is merged"
run = '''{{ releasaurus_release_command | default("releasaurus release-pr --tag-prefix '' && releasaurus release", true) }}'''
