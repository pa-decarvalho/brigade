[tools]
# renovate: datasource=github-releases depName=robgonnella/releasaurus
"aqua:robgonnella/releasaurus" = "{{ releasaurus_version | default('1.3.0', true) }}"

# Tags and publishes a merged release PR, then opens or updates the next one (tags X.Y.Z, no "v").
# This order is required: release-pr fails while a merged release PR is not tagged.
# Needs RELEASAURUS_REPO, RELEASAURUS_FORGE and a token (RELEASAURUS_<FORGE>_TOKEN): CI sets them.
[tasks."releasaurus:release"]
description = "Tag and publish a merged release PR, then open or update the next one"
run = '''{{ releasaurus_release_command | default("releasaurus release && releasaurus release-pr --tag-prefix ''", true) }}'''
