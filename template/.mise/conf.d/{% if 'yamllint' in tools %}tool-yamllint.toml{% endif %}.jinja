[tools]
# renovate: datasource=pypi depName=yamllint
"pipx:yamllint" = "{{ yamllint_version | default('1.38.0', true) }}"

[tasks."yamllint:lint"]
description = "Check YAML files with yamllint"
# Copier writes the answers file (lists without indentation); .mise-data is the GitLab CI tool cache.
run = '''{{ yamllint_lint_command | default('yamllint --strict -d "{extends: default, ignore: [.venv/, node_modules/, .mise-data/, .mise/brigade-copier-answers.yml], rules: {truthy: {check-keys: false}, new-lines: disable}}" .', true) }}'''
