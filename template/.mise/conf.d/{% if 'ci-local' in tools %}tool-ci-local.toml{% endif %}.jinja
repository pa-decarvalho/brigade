# Not a stage: run by CI, it would start the CI again. Tools are on the task, so CI does not install them.
[tasks."brigade:ci-local"]
description = "Run this project's CI locally, in Docker"
{%- if ci == 'gitlab' %}
run = '''{{ ci_local_command | default('gitlab-ci-local --variable CI_PIPELINE_SOURCE=merge_request_event', true) }}'''

[tasks."brigade:ci-local".tools]
# renovate: datasource=node-version depName=node
node = "{{ ci_local_node_version | default('26.13.0', true) }}"
# renovate: datasource=npm depName=gitlab-ci-local
"npm:gitlab-ci-local" = "{{ ci_local_version | default('4.77.1', true) }}"
{%- else %}
run = '''{{ ci_local_command | default('act pull_request' ~ (' -W .gitea/workflows' if ci == 'gitea' else '') ~ ' -P ubuntu-latest=catthehacker/ubuntu:act-24.04', true) }}'''

[tasks."brigade:ci-local".tools]
# renovate: datasource=github-releases depName=nektos/act
act = "{{ ci_local_version | default('0.2.97', true) }}"
{%- endif %}
