[tools]
# CI runners may use a minimal rustup profile, without clippy and rustfmt.
rust = { version = "1.99.1", components = "clippy,rustfmt" }

[tasks."lint:clippy"]
description = "Check code with clippy"
run = "cargo clippy --all-targets -- -D warnings"

[tasks."lint:rustfmt"]
description = "Check formatting with rustfmt"
run = "cargo fmt --check"

[tasks."test:cargo"]
description = "Run tests with cargo"
run = "cargo test"
