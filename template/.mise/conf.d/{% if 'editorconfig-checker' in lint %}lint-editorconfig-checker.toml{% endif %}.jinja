[tools]
# renovate: datasource=github-releases depName=editorconfig-checker/editorconfig-checker
editorconfig-checker = "{{ lint_editorconfig_checker_version | default('4.0.2', true) }}"

[tasks."lint:editorconfig"]
description = "Check files against .editorconfig with editorconfig-checker"
# .mise-data is the GitLab CI tool cache.
run = '''{{ lint_editorconfig_checker_command | default('editorconfig-checker -exclude "^[.]mise-data/"', true) }}'''
