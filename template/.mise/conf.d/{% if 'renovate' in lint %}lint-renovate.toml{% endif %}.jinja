[tools]
# renovate: datasource=pypi depName=check-jsonschema
"pipx:check-jsonschema" = { version = "{{ lint_renovate_version | default('0.39.0', true) }}", uvx_args = "--with json5" }

[tasks."lint:renovate"]
description = "Check the Renovate config"
run = '''{{ lint_renovate_command | default('check-jsonschema --builtin-schema vendor.renovate renovate.json', true) }}'''
