[tools]
# renovate: datasource=github-releases depName=gitleaks/gitleaks
gitleaks = "{{ lint_gitleaks_version | default('8.30.1', true) }}"

[tasks."lint:gitleaks"]
description = "Check git history and staged changes for secrets with gitleaks"
run = '''{{ lint_gitleaks_command | default('gitleaks git --redact --no-banner && gitleaks git --pre-commit --staged --redact --no-banner', true) }}'''
