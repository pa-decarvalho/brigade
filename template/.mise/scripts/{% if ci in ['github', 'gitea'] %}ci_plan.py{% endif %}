"""Write the CI jobs of each stage, read from ci.toml, as JSON matrices to $GITHUB_OUTPUT.

Run by the plan job of brigade's CI workflow: mise run brigade:ci-plan <ci.toml>.
"""

import json
import os
import sys
import tomllib
from pathlib import Path

STAGES = ("lint", "test")
KEYS = {"task", "os", "fetch-depth"}


def expand(config: dict) -> dict[str, list[dict]]:
    """One job per entry and runner: {task, os, fetch-depth}."""
    unknown = set(config) - set(STAGES)
    if unknown:
        raise SystemExit(
            f"ci.toml: unknown stages {sorted(unknown)}, expected {list(STAGES)}"
        )
    plan = {}
    for stage in STAGES:
        jobs = []
        for entry in config.get(stage, []):
            if "task" not in entry or set(entry) - KEYS:
                raise SystemExit(
                    f"ci.toml [[{stage}]]: needs task, allowed keys {sorted(KEYS)}, got {sorted(entry)}"
                )
            for runner in entry.get("os", ["ubuntu-latest"]):
                jobs.append(
                    {
                        "task": entry["task"],
                        "os": runner,
                        "fetch-depth": entry.get("fetch-depth", 1),
                    }
                )
        plan[stage] = jobs
    return plan


assert expand({"test": [{"task": "t", "os": ["a", "b"], "fetch-depth": 0}]}) == {
    "lint": [],
    "test": [
        {"task": "t", "os": "a", "fetch-depth": 0},
        {"task": "t", "os": "b", "fetch-depth": 0},
    ],
}

plan = expand(tomllib.loads(Path(sys.argv[1]).read_text()))
with open(os.environ["GITHUB_OUTPUT"], "a") as output:
    for stage, jobs in plan.items():
        print(f"{stage}: {jobs}")
        output.write(f"{stage}={json.dumps(jobs)}\n")
