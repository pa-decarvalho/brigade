---
stages:
  - lint
  - test

variables:
  MISE_DATA_DIR: $CI_PROJECT_DIR/.mise-data

default:
  image: jdxcode/mise:2026.11.2-debian
  cache:
    key: mise
    paths:
      - .mise-data/
  before_script:
{%- if project_type == 'rust' %}
    # Rust needs a C linker, which the mise image does not ship.
    - apt-get update -qq
    - apt-get install -y -qq --no-install-recommends gcc libc6-dev
{%- endif %}
    - mise trust
    - mise install

lint:
  stage: lint
  script:
    - mise run lint

test:
  stage: test
  script:
    - mise run test
