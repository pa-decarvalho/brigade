# EditorConfig is awesome: http://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# 4 space indentation
[*.{py,toml,json}]
indent_style = space
indent_size = 4

# 2 space indentation
[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.{md}]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

# The end-to-end test projects' JSON: Biome's style (tabs), which their own lint checks.
[tests/fixtures/projects/{node,bun}/*.json]
indent_style = tab
